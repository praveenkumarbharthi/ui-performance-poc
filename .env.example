# Copy to `.env` for local overrides. Never commit a real `.env` (it is git-ignored).
# This PoC uses only the PUBLIC SauceDemo demo account - no real secrets belong here.

# Target application under test
BASE_URL=https://www.saucedemo.com

# Public demo credentials (documented, non-secret SauceDemo account)
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# Run identity (optional). A timestamp-based run id is generated when unset.
# RUN_ID=local-run-001
# Run start time (ISO 8601). Used to reject stale artifacts from earlier runs.
# Set automatically by scripts/run-all.ps1 and the Jenkins pipeline.
# RUN_STARTED_AT=2026-01-01T00:00:00.000Z

# Optional reports root override (defaults to <project>/reports).
# REPORTS_DIR=

# Logging level: error | warn | info | debug
LOG_LEVEL=info

# Documented LCP/CLS settle window (ms) after the page readiness point.
LCP_OBSERVATION_MS=2500

# Multi-page Lighthouse. Pages are defined in src/config.js (lighthouse.pages);
# override with a JSON array of { name, path, requiresAuth }. Pages with
# requiresAuth=true are audited using a session cookie obtained by logging in
# with Playwright.
# LIGHTHOUSE_PAGES=[{"name":"login","path":"/","requiresAuth":false},{"name":"cart","path":"/cart.html","requiresAuth":true}]
# Optional explicit Chrome path; chrome-launcher auto-detects Chrome when unset.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Thresholds are ENFORCED by default with documented PoC targets (LCP <= 2500ms,
# CLS <= 0.1, single-user journey <= 8000ms). Set PERF_THRESHOLDS_ENABLED=false
# for observation-only mode (a disabled threshold can never fail a build).
PERF_THRESHOLDS_ENABLED=true
# Override the defaults only with an agreed baseline.
# THRESHOLD_LCP_MS=2500
# THRESHOLD_CLS=0.1
# THRESHOLD_JOURNEY_MS=8000
# Strict mode: an enforced threshold whose metric is unavailable (e.g. no LCP was
# captured) fails the gate instead of downgrading the run to unstable.
THRESHOLDS_STRICT=false

# Optional baseline comparison (only used when the file exists and is comparable).
# Save one with `npm run baseline:save`. Point BASELINE_FILE at a committed path to
# share it across machines/CI (it records the environment it was captured in).
# BASELINE_FILE=reports/baseline/summary.json
# A change below this percent is reported as "within-noise" (never a regression).
# BASELINE_NOISE_PCT=10
# A current run whose spread exceeds this percent is reported as "inconclusive".
# BASELINE_VARIABILITY_PCT=20
