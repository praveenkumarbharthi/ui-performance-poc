# Copy to `.env` for local overrides. Never commit a real `.env` (it is git-ignored).
# This PoC uses only the PUBLIC SauceDemo demo account - no real secrets belong here.

# Target application under test
BASE_URL=https://www.saucedemo.com

# Public demo credentials (documented, non-secret SauceDemo account)
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# Run identity (optional). A timestamp-based run id is generated when unset.
# RUN_ID=local-run-001

# Logging level: error | warn | info | debug
LOG_LEVEL=info

# Documented LCP/CLS settle window (ms) after the page readiness point.
LCP_OBSERVATION_MS=2500

# Multi-page Lighthouse. Pages are defined in src/config.js (lighthouse.pages);
# override with a JSON array of { name, path, requiresAuth }. Pages with
# requiresAuth=true are audited using a session cookie obtained by logging in
# with Playwright.
# LIGHTHOUSE_PAGES=[{"name":"login","path":"/","requiresAuth":false},{"name":"cart","path":"/cart.html","requiresAuth":true}]
# Optional explicit Chrome path; chrome-launcher auto-detects Chrome when unset.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Thresholds are DISABLED by default; a disabled threshold can never fail a build.
PERF_THRESHOLDS_ENABLED=false
THRESHOLD_LCP_MS=
THRESHOLD_CLS=
THRESHOLD_JOURNEY_MS=

# Optional baseline comparison (only used when the file exists and is comparable)
# BASELINE_FILE=reports/baseline/summary.json
