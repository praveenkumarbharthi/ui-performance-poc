# -----------------------------------------------------------------------------
# ui-performance-poc - example environment file (NON-SECRET configuration only)
# -----------------------------------------------------------------------------
# Copy this file to `.env` for LOCAL overrides only.
# NEVER commit a real `.env` file. It is ignored by .gitignore.
#
# This PoC only uses the PUBLIC SauceDemo demo account. Do NOT place real
# credentials, tokens or secrets here or anywhere else in the repository.
# See docs/limitations-and-next-steps.md for how to use Jenkins credentials in
# a future authenticated environment.
# -----------------------------------------------------------------------------

# Target application under test
BASE_URL=https://www.saucedemo.com

# Public demo credentials (documented, non-secret SauceDemo demo account)
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# Run identity (optional). If unset a timestamp-based run id is generated.
# RUN_ID=local-run-001

# Logging level: error | warn | info | debug
LOG_LEVEL=info

# Browser metric collection
# Documented LCP observation window (ms) after the page readiness point.
LCP_OBSERVATION_MS=2500

# Lighthouse
LIGHTHOUSE_URL=https://www.saucedemo.com/
# Optional explicit Chrome path. If unset, chrome-launcher auto-detects Chrome.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# -----------------------------------------------------------------------------
# OPTIONAL PERFORMANCE THRESHOLDS (observation mode by default)
# -----------------------------------------------------------------------------
# Thresholds are DISABLED by default. When disabled they can never fail a build.
# When enabled, inputs are validated and failures are reported separately from
# functional test failures and infrastructure failures.
PERF_THRESHOLDS_ENABLED=false
THRESHOLD_LCP_MS=
THRESHOLD_CLS=
THRESHOLD_JOURNEY_MS=

# Optional baseline comparison (only used when the file exists and is comparable)
# BASELINE_FILE=reports/baseline/summary.json
